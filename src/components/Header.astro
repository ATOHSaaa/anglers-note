---
import { getNavCategories, getNavTags } from "../utils/articles";
import { withBase } from "../utils/paths";

const categories = await getNavCategories();
const tags = getNavTags();
const navItems = [
  ...categories.map((category) => ({
    label: category.name,
    href: category.href,
  })),
  ...tags.map((tag) => ({
    label: tag.name,
    href: tag.href,
  })),
];

const searchQuery =
  Astro.url.pathname === "/search/" || Astro.url.pathname === "/search"
    ? (Astro.url.searchParams.get("q") ?? "")
    : "";
---

<header class="header">
  <div class="header__top container">
    <a href={withBase("/")} class="header__logo">
      <img src={withBase("/favicon.svg")} alt="" class="header__logo-icon" width="40" height="40" />
      <span class="header__logo-text">ツリナラ</span>
    </a>

    <form class="header__search" action={withBase("/search/")} method="get" role="search">
      <div class="header__search-field">
        <input
          type="search"
          name="q"
          class="header__search-input"
          placeholder="記事を検索"
          aria-label="記事を検索"
          value={searchQuery}
        />
        <button type="submit" class="header__search-btn" aria-label="検索">
          <svg
            class="header__search-icon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-3.5-3.5"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>

  {
    navItems.length > 0 && (
      <div class="header__nav-wrap">
        <nav class="header__nav container" aria-label="サイトメニュー">
          <ul class="header__nav-list">
            {navItems.map((item) => (
              <li>
                <a href={item.href} class="header__nav-link">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    )
  }
</header>

<style>
  .header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: var(--header-bar-height);
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
  }

  .header__logo {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 2.5rem;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .header__logo-icon {
    flex-shrink: 0;
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    translate: 0 0.08em;
  }

  .header__logo-text {
    line-height: 1;
  }

  .header__logo:hover {
    color: var(--color-text);
    opacity: 1;
    text-decoration: none;
  }

  .header__search {
    flex: 1;
    max-width: 18rem;
    margin-left: auto;
  }

  .header__search-field {
    display: flex;
    align-items: center;
    width: 100%;
    background: var(--color-bg);
    border: 1px solid #9aa3ad;
    border-radius: 9999px;
    overflow: hidden;
  }

  .header__search-field:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .header__search-input {
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text);
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0.625rem 0.5rem 0.625rem 1rem;
    appearance: none;
  }

  .header__search-input:focus {
    outline: none;
  }

  .header__search-input::placeholder {
    color: var(--color-text-muted);
  }

  .header__search-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: var(--color-text);
    padding: 0.625rem 0.875rem 0.625rem 0.5rem;
    cursor: pointer;
  }

  .header__search-btn:hover {
    color: var(--color-text);
  }

  .header__search-icon {
    display: block;
  }

  .header__nav-wrap {
    padding-top: var(--space-sm);
    padding-bottom: var(--space-sm);
  }

  .header__nav {
    min-width: 0;
  }

  .header__nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav-list li {
    margin: 0;
  }

  .header__nav-link {
    display: inline-block;
    font-size: 1rem;
    font-weight: 900;
    color: var(--color-text);
    text-decoration: none;
    padding: 0.25rem 0;
  }

  .header__nav-link:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .header__top {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
    }

    .header__logo {
      justify-content: center;
      font-size: 2.125rem;
    }

    .header__logo-icon {
      width: 2rem;
      height: 2rem;
    }

    .header__search {
      max-width: none;
      margin-left: 0;
    }

    .header__nav-list {
      justify-content: center;
      gap: var(--space-xs) var(--space-md);
    }

    .header__nav-link {
      font-size: 0.9375rem;
    }
  }
</style>
