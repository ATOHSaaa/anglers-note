---
import { withBase } from "../utils/paths";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <p class="footer__brand">ツリナラ</p>
    <p class="footer__tagline">釣りをする人のためのWebメディア</p>
    <nav class="footer__nav" aria-label="フッターナビゲーション">
      <ul class="footer__nav-list">
        <li>
          <a href={withBase("/about/")} class="footer__nav-link">ツリナラとは？</a>
        </li>
        <li>
          <a href={withBase("/privacy/")} class="footer__nav-link">プライバシーポリシー</a>
        </li>
      </ul>
    </nav>
    <p class="footer__copy">&copy; {year} ツリナラ</p>
  </div>
</footer>

<style>
  .footer {
    background: #f5f8fa;
    border-top: 1px solid var(--color-border);
    padding: var(--space-2xl) 0 var(--space-xl);
    margin-top: auto;
  }

  .footer__inner {
    text-align: center;
  }

  .footer__brand {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 1.625rem;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-xs);
    color: var(--color-text);
  }

  .footer__tagline {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-lg);
  }

  .footer__nav-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm) var(--space-lg);
    list-style: none;
    margin: 0 0 var(--space-lg);
    padding: 0;
  }

  .footer__nav-list li {
    margin: 0;
  }

  .footer__nav-link {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer__nav-link:hover {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer__copy {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
