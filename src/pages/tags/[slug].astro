---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getPublishedArticlesByTag, getTagBySlug, getTagSlugs } from "../../utils/articles";

export async function getStaticPaths() {
  return getTagSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const tag = getTagBySlug(slug!);

if (!tag) {
  return Astro.redirect("/");
}

const articles = await getPublishedArticlesByTag(tag.name);
---

<SiteLayout title={tag.name}>
  <section class="articles" aria-labelledby="articles-heading">
    <div class="section-header">
      <h1 id="articles-heading" class="section-header__title">{tag.name}</h1>
    </div>

    {articles.length > 0 ? (
      <div class="article-list">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    ) : (
      <p class="article-list__empty">記事はまだありません。</p>
    )}
  </section>
</SiteLayout>

<style>
  .articles {
    width: 100%;
  }
</style>
